{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "portfolio.v1 contract",
  "type": "object",
  "required": [
    "schema_version",
    "version",
    "as_of",
    "sources",
    "evidence",
    "company_periods",
    "evaluation",
    "labor",
    "workforce",
    "jobs",
    "scenario",
    "strategies",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "portfolio.v1"
    },
    "version": {
      "type": "string"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metadata"
      }
    },
    "company_periods": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metadata"
      }
    },
    "labor": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metadata"
      }
    },
    "workforce": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metadata"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/metadata"
          }
        ],
        "required": [
          "evidence_id",
          "review_label",
          "review_scope",
          "company_id",
          "excerpt"
        ],
        "properties": {
          "review_label": {
            "enum": [
              "deployment",
              "pilot",
              "planned",
              "hiring_innovation",
              "promotional",
              "risk",
              "none"
            ]
          },
          "review_scope": {
            "enum": [
              "internal",
              "customer_or_product",
              "unspecified"
            ]
          }
        }
      }
    },
    "scenario": {
      "$ref": "#/$defs/scenario"
    },
    "jobs": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/metadata"
          }
        ],
        "required": [
          "company_id",
          "source_native_id",
          "skill_coding_status"
        ],
        "properties": {
          "skill_coding_status": {
            "const": "estimated"
          }
        }
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "required": [
        "source_id",
        "source_url",
        "retrieved_at",
        "source_vintage",
        "geography",
        "unit_of_observation",
        "period",
        "currency",
        "price_year",
        "schema_version",
        "status"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved_at": {
          "type": "string",
          "minLength": 1
        },
        "source_vintage": {
          "type": "string",
          "minLength": 1
        },
        "geography": {
          "type": "string",
          "minLength": 1
        },
        "unit_of_observation": {
          "type": "string",
          "minLength": 1
        },
        "period": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "price_year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "schema_version": {
          "const": "portfolio.v1"
        },
        "status": {
          "enum": [
            "observed",
            "estimated",
            "scenario"
          ]
        }
      }
    },
    "route": {
      "type": "object",
      "required": [
        "capacity",
        "success_rate",
        "ready_month",
        "upfront_cost",
        "annual_recurring_cost"
      ],
      "properties": {
        "capacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "success_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ready_month": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120
        },
        "upfront_cost": {
          "type": "number",
          "minimum": 0
        },
        "annual_recurring_cost": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "skill": {
      "type": "object",
      "required": [
        "skill_id",
        "demand",
        "routes"
      ],
      "properties": {
        "skill_id": {
          "type": "string",
          "minLength": 1
        },
        "demand": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "routes": {
          "type": "object",
          "required": [
            "train",
            "redeploy",
            "hire"
          ],
          "properties": {
            "train": {
              "$ref": "#/$defs/route"
            },
            "redeploy": {
              "$ref": "#/$defs/route"
            },
            "hire": {
              "$ref": "#/$defs/route"
            }
          }
        }
      }
    },
    "scenario": {
      "allOf": [
        {
          "$ref": "#/$defs/metadata"
        }
      ],
      "type": "object",
      "required": [
        "horizon_months",
        "deadline_months",
        "annual_discount_rate",
        "annual_value_per_capability",
        "upfront_budget",
        "skills"
      ],
      "properties": {
        "status": {
          "const": "scenario"
        },
        "horizon_months": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "deadline_months": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "annual_discount_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "annual_value_per_capability": {
          "type": "number",
          "minimum": 0
        },
        "upfront_budget": {
          "type": "number",
          "minimum": 0
        },
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/skill"
          }
        }
      }
    }
  }
}
